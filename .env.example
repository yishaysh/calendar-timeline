# Neon Serverless Postgres Connection String
# Get yours from https://console.neon.tech -> Dashboard -> Connection Details
DATABASE_URL="postgres://username:password@ep-your-endpoint-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct URL for migrations (optional, if using Prisma/Drizzle)
DIRECT_URL="postgres://username:password@ep-your-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Google Gemini API Key for AI Natural Language Assistant (optional)
VITE_GEMINI_API_KEY=""

# Admin Passcode for protecting additions, edits, and deletions (default: admin123)
VITE_ADMIN_PASSWORD="admin123"
ADMIN_PASSWORD="admin123"
